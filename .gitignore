# ============================================================
# Invoice Stamper - .gitignore
# npm workspaces monorepo:
#   apps/api      Cloudflare Worker (Hono, pdf-lib, Wrangler)
#   apps/web      Svelte + Vite frontend
#   packages/shared
# ============================================================

# ---- Dependencies ----
# Matches node_modules at any depth (root and per-workspace)
node_modules/

# ---- Build & framework output ----
dist/
build/
out/
.svelte-kit/
.vite/
*.tsbuildinfo

# ---- Cloudflare / Wrangler local state ----
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# ---- Environment files & secrets ----
.env
.env.*
!.env.example

# Certificates / private keys (e.g. for signing stamped PDFs)
*.pem
*.key
*.p12
*.pfx

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Tests & coverage ----
coverage/
.nyc_output/
playwright-report/
test-results/

# ---- Editors & IDEs ----
.idea/
*.swp
*.swo
*~

# VS Code: ignore personal state, keep shared project config
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# ---- Operating system files ----
# macOS
.DS_Store
.AppleDouble
.LSOverride
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- Claude Code local settings ----
.claude/settings.local.json
